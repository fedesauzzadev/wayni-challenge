{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": { "0": { "color": "green", "index": 0, "text": "Idle" } },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "sum(bcra_import_jobs_by_status{status=~\"Loading|Aggregating\"}) or vector(0)",
          "legendFormat": "import en curso",
          "refId": "A"
        }
      ],
      "title": "Import en curso (Loading/Aggregating)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 9, "x": 6, "y": 0 },
      "id": 2,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "rate(bcra_import_lines_copied_total[1m])",
          "legendFormat": "líneas COPY/s (válidas)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "rate(bcra_import_lines_rejected_total[1m])",
          "legendFormat": "líneas rechazadas/s",
          "refId": "B"
        }
      ],
      "title": "Throughput de staging (líneas/s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 9, "x": 15, "y": 0 },
      "id": 3,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(bcra_import_phase_duration_seconds_bucket[30m])))",
          "legendFormat": "{{phase}} p95",
          "refId": "A"
        }
      ],
      "title": "Duración por fase del import (p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "lineWidth": 2, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 5 },
      "id": 4,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "sum by (status) (bcra_import_jobs_by_status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Jobs por estado",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "lineWidth": 2, "showPoints": "auto" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 5 },
      "id": 5,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "sum by (outcome) (increase(bcra_import_jobs_total[1h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "rate(bcra_import_batches_committed_total[5m])",
          "legendFormat": "lotes confirmados/s",
          "refId": "B"
        }
      ],
      "title": "Resultado de jobs (última hora) y lotes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 5 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "sum by (http_route, http_method) (rate(http_server_request_duration_seconds_count{job=\"query\"}[5m]))",
          "legendFormat": "{{http_method}} {{http_route}}",
          "refId": "A"
        }
      ],
      "title": "Requests HTTP del query-service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "bcra-prometheus" },
          "expr": "up",
          "legendFormat": "{{job}} ({{instance}})",
          "refId": "A"
        }
      ],
      "title": "Targets scrapeados por Prometheus",
      "type": "stat"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["bcra", "pipeline"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
