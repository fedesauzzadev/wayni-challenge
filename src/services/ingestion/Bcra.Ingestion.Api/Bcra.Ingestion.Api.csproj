<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)openapi\</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bcra.Ingestion.Application\Bcra.Ingestion.Application.csproj" />
    <ProjectReference Include="..\Bcra.Ingestion.Infrastructure\Bcra.Ingestion.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="CopyOpenApiDocumentToDocs"
          AfterTargets="GenerateOpenApiDocuments"
          Inputs="$(OpenApiDocumentsDirectory)$(MSBuildProjectName).json"
          Outputs="$(MSBuildThisFileDirectory)..\..\..\..\docs\openapi\ingestion.json">
    <Copy SourceFiles="$(OpenApiDocumentsDirectory)$(MSBuildProjectName).json"
          DestinationFiles="$(MSBuildThisFileDirectory)..\..\..\..\docs\openapi\ingestion.json"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
