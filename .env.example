POSTGRES_USER=bcra
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=bcra
POSTGRES_PORT=5544
POSTGRES_READONLY_PASSWORD=local-dev-readonly

INGESTION_API_PORT=18080
QUERY_API_PORT=18081
NOTIFIER_API_PORT=18082

# Observabilidad: Prometheus scrapea /metrics de los 3 servicios; Grafana trae datasource +
# dashboard del pipeline aprovisionados (admin/admin, o viewer anónimo sin login).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Tuning del import (defaults medidos con el dataset de muestra; ver README "Performance")
INGESTION_BATCH_SIZE=200000
DATABASE_MAXPOOLSIZE=50
DATABASE_MAXAUTOPREPARE=16

QUERY_TOP_MAX=100

LOCALSTACK_PORT=4566
LOCALSTACK_DEBUG=0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Bucket que crea LocalStack al iniciar (init/01-init.sh); ingestion solo puede leer buckets allow-listed
S3_BUCKET=bcra-local

# Cola SQS import-completed (creada por init/01-init.sh). ingestion publica aca el ImportCompletedEvent
# y notifier lo consume. Desde los contenedores del compose el host es "localstack" (no localhost).
SQS_IMPORT_COMPLETED_URL=http://localstack:4566/000000000000/import-completed

# Webhook opcional (HTTP POST del ImportCompletedEvent); vacio = solo log estructurado
WEBHOOK_URL=

# --- Email de "import completado" (notifier) ---
# Cambia NOTIFICATIONS__EMAIL__TO por tu mail y listo.
# Por defecto los emails los captura Mailpit del compose (UI http://localhost:8025, sin envio real
# ni credenciales). Para envio real con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SSL=true,
# SMTP_USER=tucuenta@gmail.com y SMTP_PASSWORD=<app-password de 16 chars> (https://myaccount.google.com/apppasswords).
NOTIFICATIONS__EMAIL__TO=fede.sauzza.dev@gmail.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

UPLOAD_API_KEY=local-dev-upload-key
DATA_DIR=./samples
ASPNETCORE_ENVIRONMENT=Development

# --- Admin UI (frontend/bff + frontend/web); ver docs/admin-ui.md ---
BFF_PORT=4000
WEB_PORT=5173



